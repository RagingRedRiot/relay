# Copy this file to .env and fill in values for local development.
# Loaded via dotenvy at startup; consumed by envy into Config.

# Postgres connection string. Required — startup panics if missing.
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# Listen address for the HTTP/WebSocket server.
# Optional. Default: 0.0.0.0:3000
BIND=0.0.0.0:3000

# Per-IP rate limit, requests per second (steady-state).
# Optional. Default: 4
RATE_LIMIT_PER_SECOND=4

# Per-IP rate limit, burst capacity above the steady-state rate.
# Optional. Default: 10
RATE_LIMIT_BURST=10

# tracing-subscriber env filter. Standard RUST_LOG syntax.
# Optional. Examples: "info", "relay=debug,tower_http=debug", "trace"
RUST_LOG=info

# Allow unauthenticated clients to create accounts (NewUser as the first
# message, before auth). Optional. Default: false (signups closed).
OPEN_SIGNUPS=false

ADMIN_USERNAME=admin
ADMIN_CREDENTIAL=Pass # DO NOT USE THIS